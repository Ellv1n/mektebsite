# Bu faylı `.env` adı ilə kopyala və dəyərləri doldur.
# `.env` faylı git-ə DÜŞMÜR (.gitignore-a bax).

# ─── Verilənlər bazası ───────────────────────────────────────────────
# docker-compose.yml-dəki Postgres konteyneri ilə eyni dəyərlər.
# Port 5433-dür, çünki 5432 çox vaxt maşındakı mövcud PostgreSQL quraşdırması tərəfindən tutulur.
DATABASE_URL="postgresql://sederek:sederek_local_2026@localhost:5433/sederek_shop?schema=public"

# ─── Admin hesabı (seed ilə yaradılır) ───────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="dəyiş-məni-123"

# ─── Sessiya imzası ──────────────────────────────────────────────────
# Ən azı 32 simvol. Yaratmaq üçün:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ─── E-poçt (Nodemailer / SMTP) ──────────────────────────────────────
# LOKALDA BOŞ SAXLA — bu halda e-poçt göndərilmir, məzmunu konsola çap olunur.
# Gmail üçün: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = "App Password"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Yeni sifariş bildirişinin gedəcəyi ünvan
ORDER_NOTIFICATION_EMAIL="liyevelvin22@gmail.com"

# ─── Sayt ünvanı (e-poçtdakı admin linki üçün) ───────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
